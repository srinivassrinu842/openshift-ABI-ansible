apiVersion: v1
metadata:
  name: {{ cluster_name }}
baseDomain: {{ base_domain }}

controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  replicas: {{ groups['masters'] | length }}

compute:
  - architecture: amd64
    hyperthreading: Enabled
    name: worker
    replicas: {{ groups['workers'] | default([]) | length }}

networking:
  networkType: {{ network_type | default('OVNKubernetes') }}
  clusterNetwork:
    - cidr: {{ cluster_network_cidr }}
      hostPrefix: {{ cluster_network_host_prefix }}
  serviceNetwork:
    - {{ service_network_cidr }}
{% if machine_network_cidr is defined and machine_network_cidr | trim | length > 0 %}
  machineNetwork:
    - cidr: {{ machine_network_cidr | trim }}
{% endif %}

platform:
{% if platform_type is defined and platform_type == 'baremetal' %}
  baremetal:
{% if api_vips is defined and api_vips | length > 0 %}
    apiVIPs:
{% for vip in api_vips %}
      - {{ vip }}
{% endfor %}
{% endif %}
{% if ingress_vips is defined and ingress_vips | length > 0 %}
    ingressVIPs:
{% for vip in ingress_vips %}
      - {{ vip }}
{% endfor %}
{% endif %}
{% elif platform_type is defined and platform_type == 'none' %}
  none: {}
{% endif %}

pullSecret: '{{ (abi_pull_secret_content | from_json if abi_pull_secret_content is string else abi_pull_secret_content) | to_json }}'
sshKey: '{{ abi_ssh_key_content | trim }}'
{% if fips_enabled | default(false) | bool %}
fips: true
{% else %}
fips: false
{% endif %}
{% if proxy_enabled | default(false) | bool and http_proxy is defined and http_proxy | length > 0 %}

proxy:
  httpProxy: "{{ http_proxy }}"
  httpsProxy: "{{ https_proxy if (https_proxy | default('') | length > 0) else http_proxy }}"
  noProxy: "{{ abi_computed_no_proxy }}"
{% endif %}
{% if abi_trust_bundle_content is defined and abi_trust_bundle_content | trim | length > 0 and 'BEGIN CERTIFICATE' in abi_trust_bundle_content %}

additionalTrustBundle: |
{{ abi_trust_bundle_content | trim | indent(2, True) }}
{% endif %}
{% if disconnected_install | default(false) | bool and image_digest_sources is defined and image_digest_sources | length > 0 %}

imageDigestSources:
{{ image_digest_sources | to_nice_yaml(indent=2) | indent(2) }}
{% endif %}
