apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: {{ cluster_name }}
rendezvousIP: {{ rendezvous_ip }}
{% if additional_ntp_sources is defined and additional_ntp_sources | length > 0 %}
additionalNTPSources:
{% for ntp in additional_ntp_sources %}
  - {{ ntp }}
{% endfor %}
{% endif %}
hosts:
{% for node in (groups['masters'] + groups['workers'] | default([])) %}
  - hostname: {{ node }}
    role: {{ hostvars[node].node_role | default('master' if node in groups['masters'] else 'worker') }}
{% if hostvars[node].root_device_hints is defined and hostvars[node].root_device_hints %}
    rootDeviceHints:
{% for hint_k, hint_v in hostvars[node].root_device_hints.items() %}
{% if hint_v is boolean %}
      {{ hint_k }}: {{ hint_v | lower }}
{% elif hint_v is number %}
      {{ hint_k }}: {{ hint_v }}
{% else %}
      {{ hint_k }}: "{{ hint_v }}"
{% endif %}
{% endfor %}
{% endif %}
    interfaces:
{% if hostvars[node].network_mode == 'bond' %}
{% for iface in hostvars[node].bond_config.interfaces %}
      - name: {{ iface.name }}
        macAddress: "{{ iface.mac | lower }}"
{% endfor %}
{% else %}
      - name: {{ hostvars[node].nic_config.name }}
        macAddress: "{{ hostvars[node].nic_config.mac | lower }}"
{% endif %}
    networkConfig:
      interfaces:
{% if hostvars[node].network_mode == 'bond' %}
{% for iface in hostvars[node].bond_config.interfaces %}
        - name: {{ iface.name }}
          type: ethernet
          state: up
          mac-address: "{{ iface.mac | lower }}"
{% endfor %}
        - name: {{ hostvars[node].bond_config.name }}
          type: bond
          state: up
          link-aggregation:
            mode: {{ hostvars[node].bond_config.mode | default('802.3ad') }}
            port:
{% for iface in hostvars[node].bond_config.interfaces %}
              - {{ iface.name }}
{% endfor %}
{% if hostvars[node].bond_config.options is defined and hostvars[node].bond_config.options %}
            options:
{% for opt_k, opt_v in hostvars[node].bond_config.options.items() %}
              {{ opt_k }}: "{{ opt_v }}"
{% endfor %}
{% endif %}
          ipv4:
            enabled: true
            dhcp: false
            address:
              - ip: {{ hostvars[node].bond_config.ip }}
                prefix-length: {{ hostvars[node].bond_config.prefix_length | int }}
{% else %}
        - name: {{ hostvars[node].nic_config.name }}
          type: ethernet
          state: up
          mac-address: "{{ hostvars[node].nic_config.mac | lower }}"
          ipv4:
            enabled: true
            dhcp: false
            address:
              - ip: {{ hostvars[node].nic_config.ip }}
                prefix-length: {{ hostvars[node].nic_config.prefix_length | int }}
{% endif %}
      dns-resolver:
        config:
          server:
{% if hostvars[node].network_mode == 'bond' %}
{% for dns in hostvars[node].bond_config.dns_servers %}
            - {{ dns }}
{% endfor %}
{% else %}
{% for dns in hostvars[node].nic_config.dns_servers %}
            - {{ dns }}
{% endfor %}
{% endif %}
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: {{ hostvars[node].bond_config.gateway if hostvars[node].network_mode == 'bond' else hostvars[node].nic_config.gateway }}
            next-hop-interface: {{ hostvars[node].bond_config.name if hostvars[node].network_mode == 'bond' else hostvars[node].nic_config.name }}
            table-id: 254
{% endfor %}
