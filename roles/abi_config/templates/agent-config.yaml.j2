---
apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: {{ cluster_name }}
rendezvousIP: {{ rendezvous_ip }}
{% if additional_ntp_sources is defined and additional_ntp_sources | length > 0 %}
additionalNTPSources:
{% for ntp in additional_ntp_sources %}
  - {{ ntp }}
{% endfor %}
{% endif %}
hosts:
{% for host in groups['masters'] | default([]) %}
{% set hvars = hostvars[host] %}
  - hostname: {{ host }}
    role: master
{% if hvars.root_device_hints is defined and hvars.root_device_hints %}
    rootDeviceHints:
{% for k, v in hvars.root_device_hints.items() %}
{% if v is string %}
      {{ k }}: "{{ v }}"
{% else %}
      {{ k }}: {{ v }}
{% endif %}
{% endfor %}
{% endif %}
    interfaces:
{% if hvars.network_mode | default('bond') == 'bond' %}
{% for iface in hvars.bond_config.interfaces %}
      - name: {{ iface.name }}
        macAddress: "{{ iface.mac }}"
{% endfor %}
{% else %}
      - name: {{ hvars.nic_config.name }}
        macAddress: "{{ hvars.nic_config.mac }}"
{% endif %}
    networkConfig:
      raw:
{% if hvars.network_mode | default('bond') == 'bond' %}
{{ lookup('template', 'nmstate-bond.yaml.j2') | indent(8, True) }}
{% else %}
{{ lookup('template', 'nmstate-nic.yaml.j2') | indent(8, True) }}
{% endif %}
{% endfor %}
{% for host in groups['workers'] | default([]) %}
{% set hvars = hostvars[host] %}
  - hostname: {{ host }}
    role: worker
{% if hvars.root_device_hints is defined and hvars.root_device_hints %}
    rootDeviceHints:
{% for k, v in hvars.root_device_hints.items() %}
{% if v is string %}
      {{ k }}: "{{ v }}"
{% else %}
      {{ k }}: {{ v }}
{% endif %}
{% endfor %}
{% endif %}
    interfaces:
{% if hvars.network_mode | default('bond') == 'bond' %}
{% for iface in hvars.bond_config.interfaces %}
      - name: {{ iface.name }}
        macAddress: "{{ iface.mac }}"
{% endfor %}
{% else %}
      - name: {{ hvars.nic_config.name }}
        macAddress: "{{ hvars.nic_config.mac }}"
{% endif %}
    networkConfig:
      raw:
{% if hvars.network_mode | default('bond') == 'bond' %}
{{ lookup('template', 'nmstate-bond.yaml.j2') | indent(8, True) }}
{% else %}
{{ lookup('template', 'nmstate-nic.yaml.j2') | indent(8, True) }}
{% endif %}
{% endfor %}
